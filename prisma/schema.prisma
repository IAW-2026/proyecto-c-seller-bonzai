generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
  COMPLETED
  EXPIRED
}

model SellerProfile {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  approved  Boolean  @default(false)
  suspended Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  categoryId  String?
  name        String
  description String?
  price       Float
  stock       Int
  isActive    Boolean  @default(true)
  imageUrl    String?
  isFragile   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])

}

model Order {
  id            String      @id @default(cuid())
  buyerId       String
  sellerId      String
  status        OrderStatus
  total         Float
  transactionId String?
  trackingId    String?
  paidAt        DateTime?
  createdAt     DateTime    @default(now())

  items OrderItem[]
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Float
  quantity    Int
  subtotal    Float

  order Order @relation(fields: [orderId], references: [id])
}

model Reservation {
  id        String            @id @default(cuid())
  productId String
  buyerId   String
  quantity  Int
  orderId   String?
  status    ReservationStatus
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

}
